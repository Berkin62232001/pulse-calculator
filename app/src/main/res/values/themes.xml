<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Pulse" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/pulse_navy</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Shown while the app starts: the system splash screen (backported below Android 12). -->
    <style name="Theme.Pulse.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/pulse_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Pulse</item>
    </style>
</resources>
